# GS certification Docker runtime example.
# Copy this file to .env.cert and adjust values when needed.

TZ=Asia/Seoul
PORT=4728
CERTIFICATION_MODE=true

# SQLite runtime paths inside the dashboard container.
DB_NAME=/app/data/iot_data.db
DB_JOURNAL_MODE=WAL
DB_LOCK_RETRIES=10
DB_BUSY_TIMEOUT_MS=30000
SYSTEM_MODE=docker-cert
SYSTEM_LOCK_FILE=/app/runtime/iot_dashboard.lock
SYSTEM_LOCK_STALE_SECONDS=30

# Initial accounts created only when the user table is empty.
# Change these values before real operation.
IOT_ADMIN_EMAIL=admin@example.com
IOT_ADMIN_PASSWORD=admin1234
IOT_USER_EMAIL=user@example.com
IOT_USER_PASSWORD=user1234

# Flask session secret. Change before real operation.
FLASK_SECRET_KEY=change-this-secret-before-certification

# APR AES key for AES-GCM envelope compatibility.
# Use 16, 24, or 32 bytes encoded as hex.
APR_AES_KEY_HEX=01010101010101010101010101010101

# Local certification MQTT broker.
MQTT_BROKER=mqtt-broker
MQTT_PORT=1883
