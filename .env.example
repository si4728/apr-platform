# GS certification Docker environment template.
# Copy this file to .env.cert and replace every CHANGE_ME value before execution.

TZ=Asia/Seoul
PORT=4728
CERTIFICATION_MODE=true

DB_NAME=/app/data/iot_data.db
DB_JOURNAL_MODE=WAL
DB_LOCK_RETRIES=10
DB_BUSY_TIMEOUT_MS=30000
SYSTEM_MODE=docker-cert
SYSTEM_LOCK_FILE=/app/runtime/iot_dashboard.lock
SYSTEM_LOCK_STALE_SECONDS=30

IOT_ADMIN_EMAIL=admin@example.com
IOT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
IOT_USER_EMAIL=user@example.com
IOT_USER_PASSWORD=CHANGE_ME_USER_PASSWORD

FLASK_SECRET_KEY=CHANGE_ME_32_CHAR_FLASK_SECRET_FOR_CERT
APR_AES_KEY_HEX=CHANGE_ME_32_HEX_CHAR_AES_KEY_NO_QUOTES

MQTT_BROKER=mqtt-broker
MQTT_PORT=1883
